{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,

    // The JavaScript ships without comments. `npm run build` then emits the declarations a second time
    // with --removeComments false, so dist/*.d.ts keep the JSDoc that editors show.
    "removeComments": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },

  "include": [
    "./src/**/*.ts"
  ]
}